# =============================================================================
# Next-Gen PlanFact — шаблон переменных окружения
# Скопируйте этот файл в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в git — он добавлен в .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# ОКРУЖЕНИЕ
# -----------------------------------------------------------------------------

# Режим запуска: development | production
# В development включается uvicorn --reload и детализированные ошибки в ответах.
ENVIRONMENT=development

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# БАЗА ДАННЫХ — Google Cloud SQL (PostgreSQL)
# -----------------------------------------------------------------------------

# Локальная разработка (прямое TCP-соединение):
DATABASE_URL=postgresql+asyncpg://planfact_user:strongpassword@localhost:5432/planfact_db

# Production на Cloud Run (через Cloud SQL Connector / Unix-сокет):
# DATABASE_URL=postgresql+asyncpg://planfact_user:strongpassword@/planfact_db?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Пример для Cloud SQL с IAM-аутентификацией (без пароля):
# DATABASE_URL=postgresql+asyncpg://service-account@email.com@/planfact_db?host=/cloudsql/my-project:europe-west4:planfact-prod


# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI
# -----------------------------------------------------------------------------

# API-ключ из Google AI Studio (aistudio.google.com) или сервисный аккаунт Vertex AI
GEMINI_API_KEY=AIzaSy_YOUR_GOOGLE_AI_STUDIO_KEY_HERE

# --- Обход гео-блокировок (опционально) ---

# HTTP(S)-прокси: трафик к generativelanguage.googleapis.com направляется через него.
# Поддерживаются форматы:
#   http://proxy.example.com:8080
#   http://user:password@proxy.example.com:3128
#   socks5://user:password@proxy.example.com:1080
GEMINI_PROXY=

# Кастомный API-эндпоинт: замена generativelanguage.googleapis.com.
# Используйте если у вас корпоративный API-шлюз или собственное зеркало.
GEMINI_API_ENDPOINT=


# -----------------------------------------------------------------------------
# БЕЗОПАСНОСТЬ
# -----------------------------------------------------------------------------

# Секретный ключ для подписи JWT-токенов (минимум 32 символа, случайная строка).
# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_MIN_32_CHARS

# Время жизни access-токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Время жизни refresh-токена в днях
REFRESH_TOKEN_EXPIRE_DAYS=30


# -----------------------------------------------------------------------------
# CORS (фронтенд / Google Stitch)
# -----------------------------------------------------------------------------

# Разрешённые источники через запятую. "*" — все домены (только для dev!).
# Production пример: https://app.planfact.ru,https://stitch.google.com
CORS_ORIGINS=*


# -----------------------------------------------------------------------------
# СЕРВЕР
# -----------------------------------------------------------------------------

# Порт сервера. Cloud Run автоматически подставляет PORT=8080.
PORT=8000

# Количество uvicorn workers (для production без Cloud Run):
# WEB_CONCURRENCY=4
